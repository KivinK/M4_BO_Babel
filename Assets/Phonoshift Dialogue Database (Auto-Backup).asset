    - id: 18
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 7
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Where are your companions now? I haven\u2019t seen anyone else pass
          today."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 4
      isRoot: 0
      isGroup: 0
