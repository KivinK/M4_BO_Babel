    - id: 7
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 8
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 8
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "But it seems they\u2019ve made up their minds.. I cannot offer salvation
          to those who refuse to receive it. And I won\u2019t step foot into that
          awful place. I\u2019m content staying where I am. The Whales spread their
          word well enough, and I exert what influence I still have from the safety
          of their nest!"
        type: 0
        typeString: 
