        height: 30
    - id: 29
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 7
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: If you choose to ascend, I hope you will no longer feel alone there.
          In the meantime, you will always have a place here. Among the lost. This
          earth is our home now, and it can be yours aswell.
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 4
      isRoot: 0
      isGroup: 0
      nodeColor: 
