        value: 8
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: They have heightened my senses, cleared my mind. My body is protected
          and soon the growth of these wings may be complete, and-
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
      isGroup: 0
