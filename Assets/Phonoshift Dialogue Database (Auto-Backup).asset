        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Ah, but it is! So very much, necessary. You\u2019ve come from far,
          haven\u2019t you? It\u2019s a pleasure to know the whale\u2019s call is
          reaching further and further."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
      isGroup: 0
      nodeColor: 
