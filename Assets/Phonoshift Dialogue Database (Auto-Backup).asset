      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: But there are people out there who have changed beyond recognition.
          Who can hardly walk or think clearly.
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
      isGroup: 0
