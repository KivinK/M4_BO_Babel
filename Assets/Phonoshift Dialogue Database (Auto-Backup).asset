      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 4
        originDialogueID: 19
        destinationConversationID: 4
        destinationDialogueID: 20
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
