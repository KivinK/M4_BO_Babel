      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: Oh, you talk of the divine influence the whales have over the body?
          Gaze upon me, it is a blessing! They have granted me a glimpse into their
          divine realm for they know I must not reach it yet. They are benevolent
          and all-knowing.
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
