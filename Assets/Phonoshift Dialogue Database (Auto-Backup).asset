      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "No, I don\u2019t miss my stay in the tower, nor whom I shared the
          dream with. I miss my home, back in the village. Before we started building
          up. Before the easy way out."
        type: 0
        typeString: 
