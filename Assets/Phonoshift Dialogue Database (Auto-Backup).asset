    - id: 30
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 7
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Thank you, though, I think I\u2019ll always where I came from. It
          wasn\u2019t always this hard."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 4
      isRoot: 0
