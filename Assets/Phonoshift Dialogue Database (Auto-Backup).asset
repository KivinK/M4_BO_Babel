        height: 30
    - id: 26
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 7
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: The prospect of death makes us uncaring, and reckless. I remember
          when the tower was opened for all, many rushed to be ascended.
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 4
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 4
        originDialogueID: 26
        destinationConversationID: 4
        destinationDialogueID: 27
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 163.09274
        y: 1349.5876
        width: 160
        height: 30
    - id: 27
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 7
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Trampled bodies littered the halls of the tower. I wonder if they
          lay there still. I doubt there was anyone left to give them a proper burial.
          The old and sick were left

          behind.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 4
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
