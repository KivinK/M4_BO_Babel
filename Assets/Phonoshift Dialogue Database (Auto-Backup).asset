        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Or, perhaps he\u2019s forgotten about me over the years. I\u2019m
          not sure how we\u2019re both still even alive. Perhaps we\u2019re both
          still holding on to something.. resentment, mourning, hope."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 4
      isRoot: 0
      isGroup: 0
      nodeColor: 
