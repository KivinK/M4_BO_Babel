        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "I see no reason why one would be \u201CPhysically incapable\u201D.
          Roads have been constructed, tunnels dug, ramps built, one could even use
          a horse and carriage!"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
